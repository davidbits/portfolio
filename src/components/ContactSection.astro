---
import { CONTACT } from "@/data/content";
---
<section id="contact" class="mt-8 rounded-xl bg-gray-50 p-8 text-center">
	<h2 class="mb-4 text-2xl font-bold">Get In Touch</h2>
	<p class="mx-auto mb-6 max-w-2xl text-gray-600">
		I am always open to discussing new projects, creative ideas, or opportunities to be part of your visions.
	</p>
	<div class="flex justify-center gap-4">
		<a href={`mailto:${CONTACT.email}`} class="rounded-lg bg-black px-6 py-3 font-medium text-white transition-colors hover:bg-gray-800">
			Email Me
		</a>
		<a href="/resume.pdf" target="_blank" class="rounded-lg border border-black px-6 py-3 font-medium text-black transition-colors hover:bg-gray-100">
			Download Resume
		</a>
	</div>
</section>
