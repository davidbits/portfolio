---
import { CONTACT } from "@/data/content";
---
<section id="contact" class="mt-8 rounded-lg bg-gray-50 px-4 py-6 text-center sm:rounded-xl sm:p-8">
	<h2 class="mb-4 text-2xl font-bold">Get In Touch</h2>
	<p class="mx-auto mb-6 max-w-2xl text-gray-600">
		I am always open to discussing new projects, creative ideas, or opportunities to be part of your visions.
	</p>
	<div class="flex flex-col justify-center gap-3 sm:flex-row sm:gap-4">
		<a href={`mailto:${CONTACT.email}`} class="rounded-lg bg-black px-6 py-3 text-center font-medium text-white transition-colors hover:bg-gray-800">
			Email Me
		</a>
		<a href="/resume.pdf" target="_blank" class="rounded-lg border border-black px-6 py-3 text-center font-medium text-black transition-colors hover:bg-gray-100">
			Download Resume
		</a>
	</div>
</section>
