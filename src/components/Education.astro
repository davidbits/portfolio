---
import { EDUCATION } from "@/data/content";
---
<section id="education" aria-labelledby="education-heading">
	<h2 id="education-heading" class="mb-6 border-b pb-2 text-3xl font-semibold">Education</h2>
	<div class="space-y-6">
		{EDUCATION.map((edu) => (
			<div>
				<div class="flex flex-wrap items-baseline justify-between">
					<h3 class="text-xl font-bold text-gray-900">{edu.school}</h3>
					<span class="text-sm text-gray-500">{edu.year}</span>
				</div>
				<div class="text-lg text-gray-800">{edu.degree}</div>
				<p class="mt-1 text-gray-600">{edu.details}</p>
			</div>
		))}
	</div>
</section>
