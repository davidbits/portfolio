---
import { EXPERIENCE } from "@/data/content";
---
<section id="experience" aria-labelledby="experience-heading">
	<h2 id="experience-heading" class="mb-6 border-b pb-2 text-3xl font-semibold">Experience</h2>
	<div class="space-y-10">
		{EXPERIENCE.map((job) => (
			<article class="flex flex-col gap-2">
				<div class="flex flex-wrap items-baseline justify-between gap-2">
					<h3 class="text-2xl font-bold text-gray-900">
						{job.link ? (
							<a href={job.link} target="_blank" rel="noopener noreferrer" class="hover:text-blue-700 hover:underline">{job.company}</a>
						) : (
							job.company
						)}
					</h3>
					<span class="whitespace-nowrap text-sm font-medium text-gray-500">{job.period}</span>
				</div>
				<div class="text-lg font-medium text-blue-700">{job.role}</div>
				<p class="text-gray-700">{job.description}</p>
				<ul class="mt-2 list-inside list-disc space-y-1 text-gray-600">
					{job.details.map((detail) => <li>{detail}</li>)}
				</ul>
				<div class="mt-3 flex flex-wrap gap-2 text-xs">
					{job.tech.map((t) => <span class="rounded bg-gray-100 px-2 py-1 text-gray-700">{t}</span>)}
				</div>
			</article>
		))}
	</div>
</section>
