---
import { getCollection, render } from "astro:content";
import MermaidRenderer from "@/components/MermaidRenderer.astro";
import Layout from "@/layouts/Layout.astro";
import "katex/dist/katex.min.css";

export async function getStaticPaths() {
	const posts = await getCollection("blog");
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content } = await render(post);
const hasMermaidDiagrams =
	/^[\t ]*(?:```|~~~)[\t ]*mermaid(?:[\t ].*)?$/im.test(post.body ?? "");
---

<Layout title={`${post.data.title} | Blog`} description={post.data.description}>
	<div class="mx-auto max-w-6xl px-4 py-8 sm:px-6 sm:py-12">
		<a href="/blog" class="group mx-auto mb-8 flex w-full max-w-3xl items-center text-sm font-medium text-gray-500 hover:text-black">
			<svg class="mr-2 h-4 w-4 transition-transform group-hover:-translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
			</svg>
			Back to blog
		</a>

		<header class="mx-auto mt-4 mb-12 max-w-3xl">
			<div class="mb-4 flex flex-wrap gap-2">
				{post.data.tags.map((tag) => (
					<span class="rounded-full bg-gray-100 px-3 py-1 text-xs font-semibold text-gray-700 uppercase">
						{tag}
					</span>
				))}
			</div>
			<h1 class="text-3xl font-extrabold text-gray-900 sm:text-5xl">
				{post.data.title}
			</h1>
			<time class="mt-4 block text-base text-gray-500 sm:text-lg">
				{post.data.date.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
			</time>
		</header>

		<article class="blog-article prose prose-gray mx-auto max-w-none prose-headings:font-semibold prose-a:text-blue-600 prose-pre:max-w-full prose-pre:overflow-x-auto lg:prose-lg [&_.katex-display]:overflow-x-auto [&_.katex-display]:overflow-y-hidden [&_.katex-display]:py-2">
			<Content />
		</article>
		{hasMermaidDiagrams && <MermaidRenderer />}
	</div>
</Layout>
